{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChillPos",
  "version": "0.1.0",
  "identifier": "id.nexapos.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChillPos",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "ChillPos kasir dan operasional bisnis",
    "longDescription": "Aplikasi ChillPos untuk kasir, pengelolaan produk, stok, dan operasional bisnis."
  }
}
